# Backend infrastructure
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AUTH_DATABASE_URL=jdbc:postgresql://postgres:5432/auth_db
AUTH_DATABASE_USERNAME=platform
AUTH_DATABASE_PASSWORD=platform_password
USER_DATABASE_URL=jdbc:postgresql://postgres:5432/user_db
USER_DATABASE_USERNAME=platform
USER_DATABASE_PASSWORD=platform_password
NOTIFICATION_DATABASE_URL=jdbc:postgresql://postgres:5432/notification_db
NOTIFICATION_DATABASE_USERNAME=platform
NOTIFICATION_DATABASE_PASSWORD=platform_password
PAYMENT_DATABASE_URL=jdbc:postgresql://postgres:5432/payment_db
PAYMENT_DATABASE_USERNAME=platform
PAYMENT_DATABASE_PASSWORD=platform_password
FILE_DATABASE_URL=jdbc:postgresql://postgres:5432/file_db
FILE_DATABASE_USERNAME=platform
FILE_DATABASE_PASSWORD=platform_password
AI_DATABASE_URL=jdbc:postgresql://postgres:5432/ai_db
AI_DATABASE_USERNAME=platform
AI_DATABASE_PASSWORD=platform_password
AUDIT_DATABASE_URL=jdbc:postgresql://postgres:5432/audit_db
AUDIT_DATABASE_USERNAME=platform
AUDIT_DATABASE_PASSWORD=platform_password
DATABASE_AUTO_DDL=update
FLYWAY_ENABLED=false
FLYWAY_VALIDATE_ON_MIGRATE=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=redis_password
REDIS_SSL_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=https
KAFKA_SSL_KEYSTORE_LOCATION=
KAFKA_SSL_KEYSTORE_PASSWORD=
KAFKA_SSL_KEYSTORE_TYPE=PKCS12
KAFKA_SSL_TRUSTSTORE_LOCATION=
KAFKA_SSL_TRUSTSTORE_PASSWORD=
KAFKA_SSL_TRUSTSTORE_TYPE=JKS

# Config Server
CONFIG_GIT_URI=https://github.com/manishrnl/Microservice-Industry-Level-Boiler-Plate.git
CONFIG_GIT_LABEL=main
CONFIG_GIT_SEARCH_PATHS=backend/config-server-repo
CONFIG_GIT_USERNAME=
CONFIG_GIT_TOKEN=
CONFIG_SERVER_BACKEND=native
CONFIG_NATIVE_SEARCH_LOCATIONS=file:/app/config-server-repo
CONFIG_SERVER_URL=http://config-server:8888
CONFIG_ENCRYPT_KEY=replace_with_32_byte_key
USER_DATA_ENCRYPTION_KEY=replace_with_long_random_user_data_key
CONFIG_SERVER_HOST_PORT=8888
DISCOVERY_SERVER_HOST_PORT=8761
API_GATEWAY_HOST_PORT=8080
AUTH_SERVICE_HOST_PORT=8081
USER_SERVICE_HOST_PORT=8082
NOTIFICATION_SERVICE_HOST_PORT=8083
PAYMENT_SERVICE_HOST_PORT=8084
FILE_SERVICE_HOST_PORT=8085
AI_SERVICE_HOST_PORT=8086
AUDIT_SERVICE_HOST_PORT=8087
FRONTEND_HOST_PORT=5173

# Discovery and public URLs
DISCOVERY_SERVER_URL=http://discovery-server:8761/eureka
EUREKA_USER=eureka
EUREKA_PASSWORD=eureka_password
EUREKA_URL=http://eureka:eureka_password@discovery-server:8761/eureka
EUREKA_CLIENT_ENABLED=true
EUREKA_CLIENT_REGISTER_WITH_EUREKA=true
EUREKA_CLIENT_FETCH_REGISTRY=true
EUREKA_INSTANCE_PREFER_IP_ADDRESS=true
EUREKA_HOSTNAME=localhost
EUREKA_PEERS=http://eureka:eureka_password@localhost:8761/eureka
EUREKA_REGISTER_SELF=false
EUREKA_FETCH_REGISTRY=false
BACKEND_PUBLIC_URL=http://localhost:8080
# Must match the browser origin exactly (scheme + host + port). Change if Vite uses another port (e.g. 5174).
FRONTEND_PUBLIC_URL=http://localhost:5173
VITE_APP_ENV=development
VITE_API_GATEWAY_URL=http://127.0.0.1:8080
VITE_FRONTEND_PUBLIC_URL=http://localhost:5173
VITE_OAUTH_PROVIDERS=google,github,linkedin
API_GATEWAY_URL=http://api-gateway:8080
AUTH_SERVICE_URL=http://auth-service:8081
AUTH_SERVICE_URI=http://auth-service:8081
USER_SERVICE_URL=http://user-service:8082
USER_SERVICE_URI=http://user-service:8082
NOTIFICATION_SERVICE_URL=http://notification-service:8083
NOTIFICATION_SERVICE_URI=http://notification-service:8083
PAYMENT_SERVICE_URL=http://payment-service:8084
PAYMENT_SERVICE_URI=http://payment-service:8084
FILE_SERVICE_URL=http://file-service:8085
FILE_SERVICE_URI=http://file-service:8085
AI_SERVICE_URL=http://ai-service:8086
AI_SERVICE_URI=http://ai-service:8086
AUDIT_SERVICE_URL=http://audit-service:8087
AUDIT_SERVICE_URI=http://audit-service:8087
AUTH_JWKS_URL=http://auth-service:8081/api/v1/auth/.well-known/jwks.json
AUTH_JWKS_LOCAL_URL=http://localhost:8081/api/v1/auth/.well-known/jwks.json

# Gateway and health toggles
GATEWAY_DISCOVERY_LOCATOR_ENABLED=false
GATEWAY_HTTP_CONNECT_TIMEOUT_MS=3000
GATEWAY_HTTP_RESPONSE_TIMEOUT=30s
GATEWAY_RATE_LIMIT_ENABLED=true
GATEWAY_RATE_LIMIT_INCLUDE_PROBE_PATHS=false
GATEWAY_RATE_LIMIT_FAIL_OPEN=true
GATEWAY_RATE_LIMIT_ANON_PER_MINUTE=100
GATEWAY_RATE_LIMIT_AUTH_PER_MINUTE=1000
GATEWAY_REQUEST_LOGGING_ENABLED=false
GATEWAY_SLOW_REQUEST_LOG_MS=1000
MANAGEMENT_HEALTH_REDIS_ENABLED=false
MANAGEMENT_HEALTH_DISCOVERY_ENABLED=false

# Auth service capacity tuning
AUTH_TOMCAT_MAX_THREADS=300
AUTH_TOMCAT_MIN_SPARE_THREADS=30
AUTH_TOMCAT_ACCEPT_COUNT=1000
AUTH_TOMCAT_MAX_CONNECTIONS=10000
DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=60000
DB_MAX_LIFETIME_MS=180000
DB_KEEPALIVE_TIME_MS=60000
AUTH_DB_POOL_MAX_SIZE=5
AUTH_DB_POOL_MIN_IDLE=0
AUTH_DB_CONNECTION_TIMEOUT_MS=10000
AUTH_DB_VALIDATION_TIMEOUT_MS=5000
AUTH_DB_IDLE_TIMEOUT_MS=60000
AUTH_DB_MAX_LIFETIME_MS=180000
AUTH_DB_KEEPALIVE_TIME_MS=60000
AUTH_DB_LEAK_DETECTION_MS=0

# Security
JWT_KEY_ID=platform-key-1
JWT_ISSUER=platform-auth-service
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7
SECURITY_COOKIES_SECURE=false
SECURITY_COOKIES_SAME_SITE=Lax

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_AUTHORIZATION_URI=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_OAUTH_SCOPES=openid,profile,email

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_AUTHORIZATION_URI=https://github.com/login/oauth/authorize
GITHUB_OAUTH_SCOPES=read:user,user:email

LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
LINKEDIN_ISSUER_URI=https://www.linkedin.com/oauth
LINKEDIN_AUTHORIZATION_URI=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_TOKEN_URI=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_USER_INFO_URI=https://api.linkedin.com/v2/userinfo
LINKEDIN_OAUTH_SCOPES=openid,profile,email

# AI providers
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.0-flash
GEMINI_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
