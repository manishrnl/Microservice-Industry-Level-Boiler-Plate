# Backend infrastructure
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
HIBERNATE_DRIVER_NAME=org.postgresql.Driver

AUTH_DATABASE_URL=jdbc:postgresql://postgres:5432/auth_db
AUTH_DATABASE_USERNAME=platform
AUTH_DATABASE_PASSWORD=platform_password

USER_DATABASE_URL=jdbc:postgresql://postgres:5432/user_db
USER_DATABASE_USERNAME=platform
USER_DATABASE_PASSWORD=platform_password

NOTIFICATION_DATABASE_URL=jdbc:postgresql://postgres:5432/notification_db
NOTIFICATION_DATABASE_USERNAME=platform
NOTIFICATION_DATABASE_PASSWORD=platform_password

PAYMENT_DATABASE_URL=jdbc:postgresql://postgres:5432/payment_db
PAYMENT_DATABASE_USERNAME=platform
PAYMENT_DATABASE_PASSWORD=platform_password

FILE_DATABASE_URL=jdbc:postgresql://postgres:5432/file_db
FILE_DATABASE_USERNAME=platform
FILE_DATABASE_PASSWORD=platform_password

AI_DATABASE_URL=jdbc:postgresql://postgres:5432/ai_db
AI_DATABASE_USERNAME=platform
AI_DATABASE_PASSWORD=platform_password

AUDIT_DATABASE_URL=jdbc:postgresql://postgres:5432/audit_db
AUDIT_DATABASE_USERNAME=platform
AUDIT_DATABASE_PASSWORD=platform_password

REDIS_PASSWORD=redis_password
REDIS_DATABASE_URL=redis://default:redis_password@redis:6379/0
SPRING_DATA_REDIS_URL=redis://default:redis_password@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_SSL_ENABLED=false
CACHE_ENABLED=true
CACHE_DEFAULT_TTL=PT10M
MANAGEMENT_HEALTH_REDIS_ENABLED=false
SPRING_OUTPUT_ANSI_ENABLED=ALWAYS

KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SSL_ENDPOINT_IDENTIFICATION_ALGORITHM=https
KAFKA_SSL_KEYSTORE_LOCATION=
KAFKA_SSL_KEYSTORE_PASSWORD=
KAFKA_SSL_KEYSTORE_TYPE=PKCS12
KAFKA_SSL_TRUSTSTORE_LOCATION=
KAFKA_SSL_TRUSTSTORE_PASSWORD=
KAFKA_SSL_TRUSTSTORE_TYPE=JKS

DB_POOL_MAX_SIZE=5
DB_POOL_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=10000
DB_VALIDATION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=60000
DB_MAX_LIFETIME_MS=180000
DB_KEEPALIVE_TIME_MS=60000

DATABASE_AUTO_DDL=update
FLYWAY_ENABLED=false
FLYWAY_VALIDATE_ON_MIGRATE=false
JAVA_TOOL_OPTIONS='-Djava.net.preferIPv4Stack=true -Djava.net.preferIPv6Addresses=false'





