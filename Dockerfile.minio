FROM ubuntu:24.04

ARG MINIO_VERSION=RELEASE.2025-04-22T22-12-26Z

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && curl -fsSL -o /usr/local/bin/minio "https://dl.min.io/server/minio/release/linux-amd64/archive/minio.${MINIO_VERSION}" \
    && chmod +x /usr/local/bin/minio \
    && apt-get purge -y --auto-remove curl \
    && rm -rf /var/lib/apt/lists/*

ENV MINIO_DATA_DIR=/data \
    PORT=10000 \
    MINIO_CONSOLE_PORT=10001

COPY render-minio-entrypoint.sh /usr/local/bin/render-minio-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/render-minio-entrypoint.sh \
    && chmod +x /usr/local/bin/render-minio-entrypoint.sh

EXPOSE 10000

CMD ["/usr/local/bin/render-minio-entrypoint.sh"]
