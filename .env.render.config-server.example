# Copy these into Render → config-server Web Service → Environment

SPRING_PROFILES_ACTIVE=prod

# Native mode: reads YAML bundled in the image (no Git token required).
CONFIG_SERVER_BACKEND=native
CONFIG_NATIVE_SEARCH_LOCATIONS=file:/app/config-server-repo

# Optional: switch to Git-backed config (public repo needs no token).
# CONFIG_SERVER_BACKEND=git
# CONFIG_GIT_URI=https://github.com/manishrnl/Microservice-Industry-Level-Boiler-Plate.git
# CONFIG_GIT_LABEL=main
# CONFIG_GIT_SEARCH_PATHS=backend/config-server-repo

CONFIG_ENCRYPT_KEY=replace-with-a-long-random-secret-at-least-32-chars
